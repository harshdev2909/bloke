# Copy to .env.testnet (keys) and .env.db (DATABASE_URL). Testnet only; never reuse these keys on mainnet.
RPC_URL=https://testnet-rpc.monad.xyz
RPC_URLS=https://testnet-rpc.monad.xyz,https://rpc-testnet.monadinfra.com
DEPLOYER_PRIVATE_KEY=0x…        # temporary ADMIN + LISTER
ORACLE_SIGNER_PRIVATE_KEY=0x…   # signs index pushes (KMS in the event environment)
ATTESTER_PRIVATE_KEY=0x…        # signs faucet/claim/source attestations (separate KMS key)
RELAYER_PRIVATE_KEY=0x…         # pays gas for oracle pushes (pusher only)
KEEPER_PRIVATE_KEY=0x…          # pays gas for keeper calls (no roles)
FAUCET_RELAYER_PRIVATE_KEY=0x…  # pays gas for relayed faucet claims + MON drips (API only)
ADMIN_API_TOKEN=…               # ≥ 16 chars; operator endpoints
# .env.db
DATABASE_URL='postgresql://user:pass@host/db?sslmode=require'
